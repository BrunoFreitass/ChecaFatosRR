# Copie para backend/.env (nunca faça commit do .env).
# Em produção (Cloud Run/Render) defina as mesmas variáveis no painel ou via Secret Manager.

# development | test | production  (production desliga /docs e /openapi.json)
APP_ENV=development
LOG_LEVEL=INFO

# Origens do frontend autorizadas no CORS, separadas por vírgula. Nunca use "*".
# Ex. produção: https://checafatosrr.pages.dev,https://checafatosrr.com.br
CORS_ORIGINS=http://localhost:5173

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543).
# Pode colar como "postgresql://..." — o backend converte para o driver asyncpg.
# Formato: postgresql://postgres.<project_ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Senha com caracteres especiais (@ / # : ?) precisa de URL-encode (ex.: @ vira %40).
DATABASE_URL=
# TLS na conexão com o banco. Só use false com um Postgres local.
DATABASE_SSL=true
# Opcional: caminho do certificado CA do Supabase (Database Settings > SSL Configuration).
# Se definido, o certificado do servidor é validado (verify-full). Vazio = TLS sem validação.
DATABASE_SSL_ROOT_CERT=

# ---- Login (Supabase Auth) ----
# URL do projeto: https://<project_ref>.supabase.co
SUPABASE_URL=
# Deixe VAZIO se o projeto usa "JWT Signing Keys" (ECC/RSA). Só preencha se o projeto tiver
# apenas o "Legacy JWT Secret" (Project Settings > JWT Keys).
SUPABASE_JWT_SECRET=
# SEGREDO. Project Settings > API Keys > Secret key (sb_secret_...). Usada só para excluir contas.
SUPABASE_SECRET_KEY=
# E-mail Google do administrador.
ADMIN_EMAIL=
# SEGREDO. Chave do HMAC de banimento. Gere uma vez e guarde (se mudar, banimentos deixam de valer):
#   python -c "import secrets; print(secrets.token_hex(32))"
BAN_HASH_SALT=

# ---- Checagem de links e textos (etapa 2) ----
# SEGREDO. Google AI Studio (aistudio.google.com) > Get API key. Vazio = checagem indisponível.
GEMINI_API_KEY=
# Pool da CHECAGEM, em ordem de preferência (depois dele: modo "só agências"). Um modelo sem
# cota no dia ou sem vaga no minuto é pulado sem ser chamado; o log "gemini_model_responded"
# e o "check_timing" dizem qual respondeu. Só nomes FIXOS (nunca "latest", "preview" ou "exp":
# mudam sozinhos). Liste os da sua chave em AI Studio > modelos (ou models.list).
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemma-4-31b-it
# Limites por modelo por cima da tabela do nível gratuito (app/services/model_limits.py),
# no formato modelo=rpm/rpd[/tpm]. Vazio = a tabela. Ex.: gemini-3.6-flash=5/20
# Validação de 13/10/2026: os dois Gemma ficaram desligados (RPD 0) no render.yaml.
GEMINI_MODEL_LIMITS=
# 0 = sem "thinking" (resposta em segundos; com thinking o Flash 3.x passou de 60 s).
GEMINI_THINKING_BUDGET=0
# Cada tentativa tem teto próprio; novas tentativas só para 429/500/503 e falha de rede, com
# backoff exponencial + jitter. Prazo estourado (504/timeout) passa logo ao próximo modelo.
# A checagem inteira cabe em 90 s (o Cloudflare na frente do Render corta em ~100 s):
# no máximo 25 s por tentativa e 48 s de orçamento (valores maiores impedem o boot).
GEMINI_ATTEMPT_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=2
GEMINI_BUDGET_SECONDS=48
# Tetos de SEGURANÇA globais por dia (o dia vira à meia-noite do Pacífico, como a cota
# gratuita do Google). Quem limita de verdade é o RPD de cada modelo (contador no banco).
GEMINI_DAILY_CHECKS=1000
GEMINI_DAILY_MODERATION=2000
# Pool da MODERAÇÃO (separado do da checagem: as cotas são por modelo). Esgotado: o
# comentário é publicado e vai para a fila do admin.
GEMINI_MODERATION_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it
# Comentários por usuário: 1 a cada 30 s e 20 por dia (o limite diário conta também as
# tentativas bloqueadas pela IA, que gastam a cota de moderação).
COMMENT_MIN_INTERVAL_SECONDS=30
COMMENTS_DAILY_LIMIT=20
# Cabeçalho com o IP real do cliente (ex.: cf-connecting-ip). Só preencha depois de
# conferir em /admin/diagnostico/ip que a plataforma o sobrescreve; vazio = X-Forwarded-For.
CLIENT_IP_HEADER=
# SEGREDO. GCP > APIs e serviços > ativar "Fact Check Tools API" > Credenciais > Chave de API
# (restrinja a chave a essa API). Vazio = checa sem consultar as agências.
GOOGLE_FACTCHECK_API_KEY=
# Limites por usuário: checagens novas por hora e consultas a resultados em cache por hora.
CHECK_RATE_LIMIT_PER_HOUR=10
# Teto de checagens novas por usuário em 24 h (janela móvel; consultas ao cache não contam).
CHECK_DAILY_LIMIT_PER_USER=20
CACHE_LOOKUP_LIMIT_PER_HOUR=60
# Quanto tempo um resultado vale como cache (horas).
CHECK_CACHE_HOURS=24
# Download das páginas: tempo máximo (s) e tamanho máximo (bytes, já descomprimido).
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2000000
