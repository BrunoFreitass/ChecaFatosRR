# Copie para frontend/.env.local. Variáveis VITE_* vão para o JavaScript público:
# NUNCA coloque segredos aqui (só URLs e a chave publicável do Supabase).

# URL do backend (FastAPI). Local: http://localhost:8000 · Produção: URL do Cloud Run.
VITE_API_URL=http://localhost:8000

# Supabase > Project Settings > API Keys.
# URL do projeto: https://<project_ref>.supabase.co
VITE_SUPABASE_URL=
# "Publishable key" (sb_publishable_...). Projetos antigos: a chave "anon" (legacy).
VITE_SUPABASE_PUBLISHABLE_KEY=
